# Model backend: local (Transformers) or openai (OpenAI-compatible API)
PIXEL_MODEL_PROVIDER=local
PIXEL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# For Ollama, a compatible gateway, or a hosted OpenAI-compatible service:
PIXEL_API_BASE_URL=http://127.0.0.1:11434/v1
PIXEL_API_KEY=
PIXEL_REQUEST_TIMEOUT=90
PIXEL_DB=data/pixel.db
PIXEL_MAX_NEW_TOKENS=256
PIXEL_MAX_HISTORY_MESSAGES=16
PIXEL_WEB_SEARCH_ENABLED=true
PIXEL_VISION_API_URL=
PIXEL_VISION_API_KEY=
PIXEL_VISION_MODEL=
PIXEL_HOST=127.0.0.1
PIXEL_PORT=8000
